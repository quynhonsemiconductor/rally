# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
# Set to 'true' in local dev to bypass all rate limiting. Never set in prod.
DISABLE_RATE_LIMIT=false

# ── Database ─────────────────────────────────────────────────────
# Full DSN including pool limits
# Local dev and CI supply a complete URL. Deployed environments instead set
# DATABASE_HOST/PORT/NAME as plain env plus DATABASE_USER/DATABASE_PASSWORD
# injected straight from the RDS-managed secret, so a rotated password is picked
# up automatically and no copy of it exists anywhere. See db/database-url.ts.
#
# TWO ROLES, ON PURPOSE. The app connects with DML rights only; migrations
# connect as the owner. Migration 0068 creates `rova_app` / `rova_worker` /
# `rova_migrate` (NOLOGIN until granted a password) and backend-ci.yml runs the
# whole e2e suite as `rova_app`, so a missing GRANT fails CI instead of the
# production cutover. To use them locally, once:
#   ALTER ROLE rova_app LOGIN PASSWORD 'rova_app';
# Deployed wiring and the cutover steps: docs/runbooks/db-role-least-privilege.md
DATABASE_URL=postgresql://rova_app:changeme@localhost:5432/rally_dev?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Owner connection — DDL rights. Used by `pnpm db:migrate` and `db/truncate-all.ts`
# only; never by the running app. Falls back to DATABASE_URL when unset.
DATABASE_MIGRATION_URL=postgresql://rova_migrate:changeme@localhost:5432/rally_dev?sslmode=disable

# ── Redis / Valkey ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=rally:

# ── Auth / JWT ────────────────────────────────────────────────────
# EC P-256 asymmetric keypair for ES256 signing. Generate:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out private.pem
#   openssl ec -in private.pem -pubout -out public.pem
# Base64 for ECS secrets:  base64 -w0 < private.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=rally-api
JWT_AUDIENCE=rally-web

# CSRF secret (min 32 chars)
# Signs every cookie rally sets. Distinct from CSRF_SECRET so rotating one does
# not silently rotate the other.
COOKIE_SECRET=change-me-to-a-random-32char-secret
# HMAC key binding each CSRF token to the session that requested it.
CSRF_SECRET=change-me-to-a-random-32char-secret

# Serve Swagger UI + the OpenAPI document at /api/docs. Defaults to false;
# turn it on for local dev. Never enable in a deployed environment.
SWAGGER_ENABLED=true

# ── AWS ───────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=000000000000

# LocalStack (dev) — local AWS, no real account needed.
# docker compose -f docker-compose.dev.yml up -d  ← starts LocalStack and
# creates the S3 buckets via the init hook (scripts/localstack/01-bootstrap.sh).
# Deployed resources come from infra/ (OpenTofu).
#
# Used by SES (email) and Secrets Manager. There is no SNS topic or SQS queue any
# more: the audit projection is a DB-to-DB relay (AuditProjectionRelay), because the
# queue topology declared here was more permissive than the Terraform and hid a
# 100% event-loss bug in every deployed environment.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Object storage ────────────────────────────────────────────────
# Bucket names must match scripts/localstack/01-bootstrap.sh.
#
# PRIVATE — every permission-gated upload. Served only via presigned GET.
S3_ATTACHMENTS_BUCKET=rally-attachments
# PUBLIC — avatars / workspace logos only. World-readable by key.
S3_PUBLIC_ASSETS_BUCKET=rally-public-assets

# StorageService reads STORAGE_ENDPOINT, NOT AWS_ENDPOINT_URL. Without this the
# S3 client talks to real AWS instead of LocalStack, so uploads silently fail
# against a bucket that doesn't exist in your account.
# In AWS/R2 this is set by Terraform; locally it points at LocalStack.
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test

# OPTIONAL: credentials scoped to the PUBLIC bucket only. When set, StorageService uses a
# separate S3 client for public assets, so the token that can write world-readable avatars
# is not the token that can read every permission-gated attachment. Unset (as here) means
# public assets reuse the pair above — identical to the previous behaviour. Both or neither;
# one alone is rejected at boot.
# STORAGE_PUBLIC_ACCESS_KEY_ID=test
# STORAGE_PUBLIC_SECRET_ACCESS_KEY=test
STORAGE_FORCE_PATH_STYLE=true

# CDN origin for the PUBLIC bucket only. Leave unset locally — public assets
# then fall back to a presigned GET, which works but is not CDN-cached.
# MUST NOT ever point at S3_ATTACHMENTS_BUCKET.
# CDN_PUBLIC_ASSETS_BASE_URL=

# ── Observability ─────────────────────────────────────────────────
# ON by default locally, because the compose stack now ships the collector that receives it
# (scripts/otel/collector.yaml). It was false with no collector anywhere, so every `@Span`
# and every QueueMetrics recording ran and emitted into nothing.
#
# This value only takes effect because main.ts imports `@platform/config/load-env` BEFORE
# the OTel bootstrap. Without that, `startOtel()` reads process.env before @nestjs/config
# has loaded this file, and the flag is silently unset — measured as 0 spans and 0 metric
# series against a live collector.
#
# Spans and metrics land in `docker logs rally-otel`; metrics are also readable as
# Prometheus text via `curl -s localhost:8889/metrics`.
#
# Set false when running the API without the compose stack. Deployed environments derive
# this from the otel-agent module in infra/ and it stays OFF until enabled deliberately.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=rally-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Deployment identity for telemetry — deliberately NOT NODE_ENV, which develop
# pins to "production" so dev-login stays off a public host. Unset falls back to
# NODE_ENV. Infra sets "develop" / "production".
# DEPLOYMENT_ENV=local
# Head-sampling fraction. Unset defaults to 1.0 outside production, 0.1 in it.
# OTEL_SAMPLING_PROBABILITY=1.0

LOG_LEVEL=debug
LOG_PRETTY=true
LOG_SQL=false
LOG_HTTP_BODIES=false
LOG_DEV_EMAIL_CONTENT=false

# ── Resilience ────────────────────────────────────────────────────
RESILIENCE_ENABLED=true

# ── SSO / Microsoft Entra ID (optional — leave empty to disable SSO) ──────────
# When set, the API validates Entra ID tokens via JWKS and provisions users JIT.
# ENTRA_TENANT_ID=your-azure-tenant-id
# ENTRA_CLIENT_ID=your-azure-app-client-id
# ENTRA_CLIENT_SECRET=your-azure-confidential-client-secret
# ENTRA_REDIRECT_URI=http://localhost:3000/v1/bff/callback
# Comma-separated JIT allow-list; only these email domains can self-provision.
# EMPTY means any domain, which is what a deployed environment wants once invited external
# collaborators are in play — `SSO_JIT_ENABLED=false` keeps the Rally invitation as the only gate.
# SSO_ALLOWED_EMAIL_DOMAINS=qnsc.vn

# Provision an invited external collaborator as an Entra B2B GUEST, so they can sign in with any
# real mailbox (their own Microsoft work account, Google federation, or an emailed one-time
# passcode) while the Rally invitation stays the authorization gate. Reuses the Entra app
# registration above — no extra secret. Requires the `User.Invite.All` APPLICATION permission with
# admin consent on that registration; leave OFF until the tenant admin has granted it, or every
# Graph call is a 403. Off = no guest_invite_outbox row, invitations behave exactly as before.
# ENTRA_GUEST_INVITE_ENABLED=false

# Email domains that are INTERNAL to this deployment's Entra tenant (comma-separated,
# exact domains, e.g. `qnsc.vn`). An invited address on one of these is a directory
# member who signs in over the workspace SSO connection, so inviteMember skips the
# B2B guest queue for them and the invitation is additionally deliverable by
# copy-link (POST /v1/workspaces/:id/invitations/:invitationId/link) — the path to
# use when mail filters quarantine transactional senders, which is common for
# same-tenant recipients. Empty = every address is treated as external, as before.
# INTERNAL_EMAIL_DOMAINS=qnsc.vn

# SES asynchronous email feedback. CONFIGSET tags every send so bounce/complaint events
# fan out SNS -> SQS -> the worker's BounceFeedbackService, which marks the email_outbox
# row bounced/complained; QUEUE_URL is that queue and doubles as the consumer's on/off
# switch (unset = off, the pre-loop behaviour — local dev and provider!=ses). Infra
# provisions both in infra/live/_shared for deployed environments.
# SES_BOUNCE_CONFIGSET=rally-email-feedback
# SES_BOUNCE_QUEUE_URL=

# ── Platform admin (SSO auto-elevation) ─────────────────────────────────────
# Auth is SSO-only (passwordless). The first admin is NOT a seeded account —
# put their Entra email here and they are auto-granted workspace_admin on first
# SSO login. Comma-separated.
PLATFORM_ADMIN_EMAILS=

# ── Tenant bootstrap (workspace + SSO connection) ───────────────────────────
# The primary workspace + Entra SSO connection are created on every deploy (all
# envs) so real users can JIT-provision. These override the defaults.
# BOOTSTRAP_WORKSPACE_NAME=ACME Corp
# BOOTSTRAP_WORKSPACE_SLUG=main

# Demo fixtures (demo users, sample projects/work items) — dev/staging/E2E only.
# Never set in production; prod runs only the prod-safe roles + tenant bootstrap.
SEED_ON_DEPLOY=true

# ── Email (─────────────────────────────────────────────
EMAIL_PROVIDER=ses
# REQUIRED whenever EMAIL_PROVIDER is not 'dev' — `env.schema.ts` now enforces this at boot
# (superRefine on EMAIL_PROVIDER !== 'dev'), and EmailService / the providers additionally throw
# at SEND time if it is ever absent, rather than silently sending as `"Mini Rally" <>` (which used
# to make SES reject every message and, after three failures, open the email circuit breaker for
# the life of the process). Locally, verify the address in localstack too:
#   docker exec -i rally-localstack awslocal ses verify-email-identity --email-address noreply@qnsc.dev
MAIL_FROM_EMAIL=noreply@qnsc.dev
